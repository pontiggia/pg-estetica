# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the reminders cron (bypasses RLS). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Admin (Paula) phone in international format, e.g. 5491123456789
WHATSAPP_ADMIN_PHONE=
# Admin templates (optional, defaults: nueva_cita / cita_cancelada)
WHATSAPP_TEMPLATE_NEW=
WHATSAPP_TEMPLATE_CANCELLED=
# Patient templates (names as approved in WhatsApp Manager)
WHATSAPP_TEMPLATE_CLIENT_CONFIRMED=
WHATSAPP_TEMPLATE_CLIENT_REMINDER=

# Secret used by Vercel Cron to call /api/cron/reminders (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
